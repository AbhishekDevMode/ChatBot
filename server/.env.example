# Database Connection String (MongoDB Atlas)
MONGODB_CONNECT=mongodb+srv://<username>:<password>@cluster0.xxx.mongodb.net/chatbot?retryWrites=true&w=majority

# JWT Secret Key
JWT_SECRET=your_super_secret_jwt_key_here

# Port (Set automatically by Render/Railway, defaults to 4000 locally)
PORT=4000

# Node Environment
NODE_ENV=production
